{
  "name": "folio-workspace",
  "version": "0.4.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "node scripts/build.mjs",
    "start": "vite preview --host 127.0.0.1 --port 5174 --strictPort",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app components/folio lib/folio scripts main.ts render.tsx recovery.ts",
    "eval": "node --experimental-strip-types scripts/evaluate-retrieval.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@mlc-ai/web-llm": "^0.2.79",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/extension-table": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dexie": "^4.0.0",
    "docx": "^9.0.0",
    "lucide-react": "^1.31.0",
    "pdfjs-dist": "^5.4.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "fflate": "^0.8.3",
    "prettier": "^3.9.9",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module",
  "description": "A local-first workspace for research, versioned citations, and on-device AI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhzhg-dev/folio.git"
  }
}
